    "plt.figure(figsize=(10, 5))\n",
    "plt.hist(boot_thetas, bins=30, edgecolor=\"black\")\n",
    "plt.axvline(theta_hat, linestyle=\"--\", label=\"Original estimate\")\n",
    "plt.xlabel(\"Bootstrap estimates of treatment effect\")\n",
    "plt.ylabel(\"Frequency\")\n",
    "plt.title(\"Bootstrap Distribution of the Estimated Treatment Effect\")\n",
    "plt.legend()\n",
    "plt.show()"
   ]
