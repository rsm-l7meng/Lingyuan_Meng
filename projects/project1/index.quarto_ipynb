       "3                     p-value  0.032450"
      ]
     },
     "execution_count": 6,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "z_stat = theta_hat / analytic_se\n",
    "p_value = 2 * (1 - stats.norm.cdf(abs(z_stat)))\n",
    "\n",
    "hypothesis_results = pd.DataFrame({\n",
    "    \"Quantity\": [\"Estimated treatment effect\", \"Analytical SE\", \"z-statistic\", \"p-value\"],\n",
    "    \"Value\": [theta_hat, analytic_se, z_stat, p_value]\n",
    "})\n",
    "\n",
    "hypothesis_results"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "515a543f",
   "metadata": {},
   "source": [
    "To visualize the test, I compare the observed z-statistic to the Standard Normal distribution and mark the two-sided rejection regions at the 5% significance level."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "d6fb1140",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
